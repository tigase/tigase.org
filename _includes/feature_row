{% if include.id %}
{% assign feature_row = page[include.id] %}
{% else %}
{% assign feature_row = page.feature_row %}
{% endif %}

<div class="feature__wrapper">

    {% for f in feature_row %}
    {% if include.id contains 'col2' %}
    <div class="feature__item2">
        {% elsif include.id contains 'col4' %}
        <div class="feature__item4">
            {% elsif include.id contains 'col5' %}
            <div class="feature__item5">
                {% elsif include.id contains 'col7' %}
                <div class="feature__item7">
                    {% else %}
                    <div class="feature__item{% if include.type %}--{{ include.type }}{% endif %}">
                        {% endif %}
                        <div class="archive__item">
                            {% if f.image_path %}
                            {% if include.id contains 'col7' %}
                            <div class="archive__item-teaser-img-ssmall">
                                {% elsif include.id contains 'col4' or include.id contains 'col5' %}
                                <div class="archive__item-teaser-img-small">
                                    {% elsif include.id contains 'col3' or include.id contains 'col2' %}
                                    <div class="archive__item-teaser-img-medium">
                                        {% else %}
                                        <div class="archive__item-teaser">
                                            {% endif %}
                                            <img src="{{ f.image_path | relative_url }}"
                                                 alt="{% if f.alt %}{{ f.alt }}{% endif %}">
                                            {% if f.image_caption %}
                                            <span class="archive__item-caption">{{ f.image_caption | markdownify | remove: "<p>" | remove: "</p>" }}</span>
                                            {% endif %}
                                        </div>
                                        {% endif %}

                                        <div class="archive__item-body">

                                            <div class="text">
                                            {% if f.title %}
                                            <h2 class="archive__item-title">{{ f.title }}</h2>
                                            {% endif %}

                                            {% if f.subtitle %}
                                            <div class="archive__item-subtitle" {% if f.center %} style="text-align:center;" {% endif %}>
                                                {{ f.subtitle | markdownify }}
                                            </div>
                                            {% endif %}



                                            {% if f.excerpt %}
                                            <div class="archive__item-excerpt"  {% if f.center %} style="text-align:center;" {% endif %}>
                                                {{ f.excerpt | markdownify }}
                                            </div>
                                            {% endif %}
                                            </div>

                                            <div class="archive__item-btn flex-space" {% if f.center %} style="justify-content:center;" {% endif %}>
                                                {% if f.url %}
                                                <div><a href="{{ f.url | relative_url }}" class="btn {{ f.btn_class }}">{{ f.btn_label | default: site.data.ui-text[site.locale].more_label | default: "Learn More" }}</a></div>
                                                {% endif %}

                                                {% if f.subicon %}
                                                <div class="archive__item-subtitle-img">
                                                    <a href="{{ f.suburl | relative_url }}"><img src="{{ f.subicon | relative_url }}"></a>
                                                </div>
                                                {% endif %}


                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}

                            </div>
